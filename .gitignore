# Extracted source bundle. Huge, purchased, and reproducible from the zips:
#   go run ./cmd/assetpipe extract tier1
assets-raw/

# Build output. dist/ holds shareable builds, which DO contain the third-party
# art and audio — shipping that in a game is licensed, committing it is not.
/slycrel
/dist/

# Save games. Play saves are scratch; the hand-curated fixtures under
# saves/fixtures/ are committed, because they are what the regression tests
# load and what a playtest starts from to reach a specific state.
*.save.json
/saves/*
!/saves/fixtures/

.DS_Store

# Scratch screenshot output. The curated set lives in docs/screenshots/.
/shots/

# Claude Code session scaffolding: worktrees are checkouts, not content.
.claude/worktrees/
